{
  "name": "bonya-memories",
  "version": "1.0.0",
  "description": "Сайт памяти о британской кошке Боне — статический сайт для Azure Static Web Apps",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint:html": "html-validate \"*.html\"",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "test": "node --test",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^17.8.0",
    "html-validate": "^9.5.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "overrides": {
    "flat-cache": "6.1.23"
  }
}
